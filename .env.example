# HKGAI 使用 Chat Completions。切换课程端点时填写对应的模型 ID。
# course 保持兼容并启用 llm.toml 的供应商选择；仅离线调试时改为 mock。
COLLABORATION_MODEL_MODE=course
COURSE_API_BASE_URL=https://api1.hkgai.net/v1
COURSE_API_MODEL=t2_hkgai-v3_fp8_1m_e7

# 将老师发的 API Key 粘贴在等号后。
COURSE_API_KEY=

# 只填写所选供应商的 Key；不需要修改或删除现有 HKGAI Key。
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=

# 可选：启用了 JSON 输出的 SearXNG 搜索端点，留空则不启用检索。
COURSE_SEARCH_URL=
# 搜索服务需要 Bearer 凭据时填写；否则留空。
COURSE_SEARCH_API_KEY=
